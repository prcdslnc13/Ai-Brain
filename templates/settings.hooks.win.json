{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__BRAIN_LAUNCH__\" session_start --part 1 --parts 4",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__BRAIN_LAUNCH__\" session_start --part 2 --parts 4",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__BRAIN_LAUNCH__\" session_start --part 3 --parts 4",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__BRAIN_LAUNCH__\" session_start --part 4 --parts 4",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__BRAIN_LAUNCH__\" subagent_start --part 1 --parts 4",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__BRAIN_LAUNCH__\" subagent_start --part 2 --parts 4",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__BRAIN_LAUNCH__\" subagent_start --part 3 --parts 4",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__BRAIN_LAUNCH__\" subagent_start --part 4 --parts 4",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__BRAIN_LAUNCH__\" stop",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__BRAIN_LAUNCH__\" user_prompt_submit",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__BRAIN_LAUNCH__\" pre_compact",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__BRAIN_LAUNCH__\" session_end",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
